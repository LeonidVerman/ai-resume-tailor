  src = b'<!DOCTYPE html>\n<html><head>\n<meta charset="utf-8">\n<style>\n@font-face { font-family: Calibri; src: url("file:///C:/WINDOWS/Fonts/calibri.ttf"); font-weight: normal; font-style: normal; }\n@font-face { font-family: Calibri; src: url("file:///C:/WINDOWS/Fonts/calibrib.ttf"); font-weight: bold; font-style: normal; }\n@font-face { font-family: Calibri; src: url("file:///C:/WINDOWS/Fonts/calibrii.ttf"); font-weight: normal; font-style: italic; }\n@font-face { font-family: Calibri; src: url("file:///C:/WINDOWS/Fonts/calibriz.ttf"); font-weight: bold; font-style: italic; }\n@font-face { font-family: Cambria; src: url("file:///C:/WINDOWS/Fonts/cambria.ttc"); font-weight: normal; font-style: normal; }\n@font-face { font-family: Cambria; src: url("file:///C:/WINDOWS/Fonts/cambriab.ttf"); font-weight: bold; font-style: normal; }\n@font-face { font-family: Cambria; src: url("file:///C:/WINDOWS/Fonts/cambriai.ttf"); font-weight: normal; font-style: italic; }\n@font-face { font-family: Cambria; src: url("file:///C:/WINDOWS/Fonts/cambriaz.ttf"); font-weight: bold; font-style: italic; }\n@page { margin: 2.50cm 3.18cm 0.49cm 3.18cm; }\nbody { font-family: Cambria, Georgia, serif; font-size: 11.0pt; margin: 0; color: #000; }\nh1 { font-family: Calibri, Arial, sans-serif; font-size: 26.0pt; font-weight: bold; text-align: center; margin: 0; }\nh2 { font-family: Calibri, Arial, sans-serif; font-size: 14.0pt; font-weight: bold; margin: 0; }\np { margin: 0; line-height: 1.15; }\np.spacer { line-height: 1.0; }\np.body-text { }\np.exp-header { font-family: Calibri, Arial, sans-serif; font-weight: bold; }\np.bullet-item { padding-left: 36pt; text-indent: -18pt; }\n</style>\n</head><body>\n<h1 style="text-align:center; line-height:30.8pt"><span style="color:#16355C">Leonid</span><span style="color:#16355C"> </span><span style="color:#16355C">Verman</span></h1>\n<p class="body-text" style="text-align:center; margin-left:50.9pt; margin-right:50.6pt; text-indent:-0.3pt; margin-top:19.9pt; line-height:1.150">Vancouver, Canada | +1 778 317 3248 | <u>leonidverman@gmail.com</u> | LinkedIn:<u>https://www.linkedin.com/in/leonid-verman-3569b71b2/</u><span style="color:#00007F"> </span>|</p>\n<p class="spacer" style="margin-top:11.1pt">&nbsp;</p>\n<h2 style="margin-left:54.0pt; text-indent:-17.9pt"><span style="color:#355E90">Professional Summary</span></h2>\n<p class="body-text" style="margin-right:1.6pt; margin-top:2.6pt; line-height:1.150">Experienced engineer with 10 years in distributed systems.</p>\n<p class="spacer" style="margin-top:10.9pt">&nbsp;</p>\n<h2 style="margin-left:54.0pt; text-indent:-17.9pt"><span style="color:#355E90">Experience</span></h2>\n<p class="exp-header" style="margin-top:12.6pt"><strong><span style="color:#4E80BC; font-size:13.0pt; font-family:Calibri">Senior Engineer | Acme Corp</span></strong></p>\n<p class="body-text" style="margin-top:2.2pt">Jan 2022 \xe2\x80\x93 Present</p>\n<p class="bullet-item" style="padding-left:36.0pt; text-indent:-18.0pt; margin-top:11.9pt">&#x2022;&#x00A0;<span style="color:#000000">Built distributed backend services.</span></p>\n<p class="bullet-item" style="padding-left:36.0pt; text-indent:-18.0pt; margin-top:11.9pt">&#x2022;&#x00A0;<span style="color:#000000">Reduced latency by 30%.</span></p>\n<p style="margin-left:28.9pt; margin-top:2.3pt"><strong><span style="color:#4E80BC; font-size:13.0pt; font-family:Calibri">Petersburg</span></strong></p>\n<p class="body-text" style="margin-top:2.4pt">Jan 2001 \xe2\x80\x93 Sep 2003</p>\n<p class="bullet-item" style="padding-left:36.0pt; text-indent:-18.0pt; margin-top:11.9pt; line-height:1.117">&#x2022;&#x00A0;Implemented UML-to-XML import/export using XMI standards, enabling seamless model interoperability for JBuilder and Together IDE.</p>\n<p class="exp-header" style="margin-top:10.1pt"><strong><span style="color:#4E80BC; font-size:13.0pt; font-family:Calibri">QA</span></strong><strong><span style="color:#4E80BC; font-size:13.0pt; font-family:Calibri"> </span></strong><strong><span style="color:#4E80BC; font-size:13.0pt; font-family:Calibri">Engineer/Software</span></strong><strong><span style="color:#4E80BC; font-size:13.0pt; font-family:Calibri"> </span></strong><strong><span style="color:#4E80BC; font-size:13.0pt; font-family:Calibri">Developer|</span></strong><strong><span style="color:#4E80BC; font-size:13.0pt; font-family:Calibri"> </span></strong><strong><span style="color:#4E80BC; font-size:13.0pt; font-family:Calibri">ZAO</span></strong><strong><span style="color:#4E80BC; font-size:13.0pt; font-family:Calibri"> </span></strong><strong><span style="color:#4E80BC; font-size:13.0pt; font-family:Calibri">Comita,</span></strong><strong><span style="color:#4E80BC; font-size:13.0pt; font-family:Calibri"> </span></strong><strong><span style="color:#4E80BC; font-size:13.0pt; font-family:Calibri">St.</span></strong><strong><span style="color:#4E80BC; font-size:13.0pt; font-family:Calibri"> </span></strong><strong><span style="color:#4E80BC; font-size:13.0pt; font-family:Calibri">Petersburg</span></strong></p>\n<p class="body-text" style="margin-top:2.4pt">Aug 1999 \xe2\x80\x93 Dec 2000</p>\n<p class="bullet-item" style="padding-left:36.0pt; text-indent:-18.0pt; margin-top:11.9pt">&#x2022;&#x00A0;Improved QA process by automating testing for banking and supervisory systems.</p>\n<p class="spacer">&nbsp;</p>\n<p class="spacer" style="margin-top:0.2pt">&nbsp;</p>\n<h2 style="margin-left:54.0pt; text-indent:-17.9pt"><span style="color:#355E90">Education</span></h2>\n<p class="bullet-item" style="padding-left:36.0pt; text-indent:-18.0pt; margin-top:2.5pt; line-height:1.117">&#x2022;&#x00A0;M.Sc., Microcomputer &amp; Network Software \xe2\x80\x93 St. Petersburg Technical State University, Russia (1999)</p>\n<p class="spacer" style="margin-top:11.2pt">&nbsp;</p>\n<h2 style="margin-left:54.0pt; text-indent:-17.9pt"><span style="color:#355E90">Technical Skills</span></h2>\n<p class="body-text" style="margin-right:1.6pt; margin-top:2.6pt; line-height:1.150">Python, Kafka, Kubernetes</p>\n<p class="spacer" style="margin-right:91.5pt; line-height:1.150">&nbsp;</p>\n<p class="spacer" style="margin-right:1.6pt; line-height:1.150">&nbsp;</p>\n<p class="spacer" style="line-height:12.8pt">&nbsp;</p>\n<p class="spacer" style="margin-right:1.6pt; margin-top:1.8pt; line-height:1.150">&nbsp;</p>\n<p class="spacer" style="margin-right:13.8pt; line-height:1.150">&nbsp;</p>\n</body></html>'

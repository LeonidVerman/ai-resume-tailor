          "text": "Experience",
          "parser_semantic": "section_heading"
        },
        {
          "para_id": "para_15",
          "text": "Restaurant Manager | Contoso Bar and Grill",
          "parser_semantic": "role_header"
        },
        {
          "para_id": "role_1_normA_1",
          "text": "September 20XX – Present",
          "parser_semantic": "role_meta"
        },
        {
          "para_id": "para_16",
          "text": "Recruit, hire, train, and coach over 30 staff members on customer service skills, food & beverage knowledge, sales, and health & safety standards.",
          "parser_semantic": "bullet"
        },
        {
          "para_id": "para_17",
          "text": "Reduced costs by 7% through controls on overtime, operational efficiencies, and reduced waste. ",
          "parser_semantic": "bullet"
        },
        {
          "para_id": "para_18",
          "text": "Consistently exceed monthly sales goals by a minimum of 10% by training FOH staff on upselling techniques and by creating a featured food and beverage program.",
          "parser_semantic": "bullet"
        },
        {
          "para_id": "para_19",
          "text": "Restaurant Manager | Fourth Coffee Bistro",
          "parser_semantic": "role_header"
        },
        {
          "para_id": "role_2_normA_2",
          "text": "June 20XX – August 20XX",
          "parser_semantic": "role_meta"
        },
        {
          "para_id": "para_20",
          "text": "Created a cross-training program ensuring FOH staff members were able to perform confidently and effectively in all positions. ",
          "parser_semantic": "bullet"
        },
        {
          "para_id": "para_21",
          "text": "Grew customer based and increased restaurant social media accounts by 19% through interactive promotions, engaging postings, and contests. ",
          "parser_semantic": "bullet"
        },
        {
          "para_id": "para_22",
          "text": "Created and implemented staff health and safety standards compliance training program, achieving a score of 99% from the Board of Health. ",
          "parser_semantic": "bullet"
        },
        {
          "para_id": "para_23",
          "text": "Successfully redesigned existing inventory system, ordering and food storage practices, resulting in a 6% decrease in food waste and higher net profits.",
          "parser_semantic": "bullet"
        }

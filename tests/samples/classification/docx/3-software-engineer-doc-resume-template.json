            "parser_semantic": "paragraph"
          },
          {
            "para_id": "para_46",
            "text": "January 2022 - current / New York, NY",
            "parser_semantic": "role_meta"
          },
          {
            "para_id": "para_47",
            "text": "Architected backend services supporting vehicle logistics workflows, enabling dispatch systems to process ~12k shipment events per day with reliable status synchronization.",
            "parser_semantic": "role_intro"
          },
          {
            "para_id": "para_48",
            "text": "Optimized route-planning queries in a microservices environment using Python and PostgreSQL, reducing average API response time by 38% during peak operations.",
            "parser_semantic": "role_intro"
          },
          {
            "para_id": "para_49",
            "text": "Implemented automated validation checks across shipment ingestion pipelines, improving operational data accuracy across 5 core internal systems used by dispatch teams.",
            "parser_semantic": "role_intro"
          },
          {
            "para_id": "para_50",
            "text": "Partnered with product and operations stakeholders to ship incremental platform releases on a bi-weekly cadence, accelerating delivery of new carrier integration features.",
            "parser_semantic": "role_intro"
          },
          {
            "para_id": "para_31",
            "text": "Software Engineer",
            "parser_semantic": "section_heading"
          },
          {
            "para_id": "para_52",

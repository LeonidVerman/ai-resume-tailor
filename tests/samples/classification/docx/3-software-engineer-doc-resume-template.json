          },
          {
            "para_id": "para_60",
            "text": "April 2018 - March 2019 / Pittsburgh, PA",
            "parser_semantic": "role_meta"
          },
          {
            "para_id": "para_61",
            "text": "Built internal dashboards to visualize campaign performance metrics, enabling analysts to monitor 150+ active advertising experiments.",
            "parser_semantic": "role_intro"
          },
          {
            "para_id": "para_62",
            "text": "Automated recurring data preparation tasks in Python, reducing manual analyst workload by ~6 hours per week.",
            "parser_semantic": "role_intro"
          },
          {
            "para_id": "para_63",
            "text": "Investigated anomalies in digital campaign reporting pipelines, resolving discrepancies affecting three client reporting workflows.",
            "parser_semantic": "role_intro"
          },
          {
            "para_id": "para_64",

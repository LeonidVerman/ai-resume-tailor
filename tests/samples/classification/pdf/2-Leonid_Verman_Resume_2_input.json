        {
          "para_id": "para_45",
          "text": "JUNIOR SOFTWARE DEVELOPER | IBM | NEW YORK, NY",
          "parser_semantic": "role_header"
        },
        {
          "para_id": "para_46",
          "text": "JUNE 2023 – CURRENT",
          "parser_semantic": "role_meta"
        },
        {
          "para_id": "para_33",
          "text": "Enhance system security to safeguard data with multi-factor authentication for over 1 million users",
          "parser_semantic": "bullet"
        },
        {
          "para_id": "para_49",
          "text": "Implement new features for high-traffic web applications using Java and Python",
          "parser_semantic": "bullet"
        },
        {
          "para_id": "para_35",
          "text": "Support migration projects to move significant portions of an application to the cloud, improving scalability by 40%",
          "parser_semantic": "bullet"
        },
        {
          "para_id": "para_36",
          "text": "Engage in peer code reviews to ensure adherence to coding best practices and IBM standards",
          "parser_semantic": "bullet"
        },
        {
          "para_id": "para_37",
          "text": "Resolved an average of 150 bug fixes since June 2023 for apps post-launch to ensure seamless UX",
          "parser_semantic": "bullet"
        },
        {
          "para_id": "para_56",
          "text": "SOFTWARE ENGINEERING INTERN | MICROSOFT | REDMOND, WA",
          "parser_semantic": "role_header"
        },
        {
          "para_id": "para_57",
          "text": "MAY 2023 – AUGUST 2023",
          "parser_semantic": "role_meta"
        },
        {
          "para_id": "para_40",
          "text": "Worked alongside the quality assurance team to identify and fix software bugs, resolving over 100 user-reported issues",
          "parser_semantic": "bullet"
        },
        {
          "para_id": "para_60",
          "text": "Participated in brainstorming ideas and solutions for new feature development",
          "parser_semantic": "bullet"
        },
        {
          "para_id": "para_42",
          "text": "Assisted in conducting user acceptance testing (UAT) to gather feedback and identify areas of improvement",
          "parser_semantic": "bullet"
        },
        {
          "para_id": "para_43",
          "text": "Partnered with software engineers to develop a user personalization feature that led to a 10% increase in daily active users within the first month of release",
          "parser_semantic": "bullet"
        },
        {
          "para_id": "para_65",
          "text": "Supported a security audit to identify and remedy 15 potential security threats",
          "parser_semantic": "bullet"
        }

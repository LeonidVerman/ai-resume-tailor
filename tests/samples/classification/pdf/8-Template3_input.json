          "parser_semantic": "role_meta"
        },
        {
          "para_id": "para_10",
          "text": "Recruit, hire, train, and coach over 30 staff members on customer service skills, food & beverage knowledge, sales, and health & safety standards.",
          "parser_semantic": "bullet"
        },
        {
          "para_id": "para_22",
          "text": "Reduced costs by 7% through controls on overtime, operational efficiencies, and reduced waste.",
          "parser_semantic": "bullet"
        },
        {
          "para_id": "para_12",
          "text": "Consistently exceed monthly sales goals by a minimum of 10% by training FOH staff on upselling techniques and by creating a featured food and beverage program.",

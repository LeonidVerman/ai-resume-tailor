          "parser_semantic": "role_meta"
        },
        {
          "para_id": "para_14",
          "text": "Created a cross-training program ensuring FOH staff members were able to perform confidently and effectively in all positions.",
          "parser_semantic": "bullet"
        },
        {
          "para_id": "para_15",
          "text": "Grew customer based and increased restaurant social media accounts by 19% through interactive promotions, engaging postings, and contests.",
          "parser_semantic": "bullet"
        },
        {
          "para_id": "para_16",
          "text": "Created and implemented staff health and safety standards compliance training program, achieving a score of 99% from the Board of Health.",
          "parser_semantic": "bullet"
        },
        {
          "para_id": "para_32",
          "text": "Successfully redesigned existing inventory system, ordering and food storage practices, resulting in a",
          "parser_semantic": "bullet"
        },
        {
          "para_id": "para_33",
          "text": "6% decrease in food waste and higher net profits.",
          "parser_semantic": "bullet"
        }

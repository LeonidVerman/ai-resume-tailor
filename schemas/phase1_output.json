{
  "type": "object",
  "required": [
    "role_level",
    "resume_mode",
    "jd_top_themes",
    "vocabulary_anchoring",
    "evidence_map",
    "resume_strategy",
    "cover_letter_strategy",
    "risk_checks"
  ],
  "additionalProperties": false,
  "properties": {

    "role_level": {
      "type": "string",
      "enum": ["director", "manager", "principal", "staff", "senior", "mid", "junior"]
    },

    "resume_mode": {
      "type": "string",
      "enum": [
        "technical_depth",
        "manager_delivery",
        "architecture_governance",
        "product_growth",
        "culture_building"
      ]
    },

    "jd_top_themes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["theme", "priority", "why_important", "keywords"],
        "additionalProperties": false,
        "properties": {
          "theme":         { "type": "string" },
          "priority":      { "type": "string", "enum": ["primary", "secondary", "supporting"] },
          "why_important": { "type": "string" },
          "keywords":      { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "vocabulary_anchoring": {
      "type": "object",
      "required": ["must_embed", "optional_embed"],
      "additionalProperties": false,
      "properties": {
        "must_embed":   { "type": "array", "items": { "type": "string" } },
        "optional_embed": { "type": "array", "items": { "type": "string" } }
      }
    },

    "evidence_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["theme", "evidence", "gaps", "safe_translation"],
        "additionalProperties": false,
        "properties": {
          "theme": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source", "location", "quote", "allowed_claims"],
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "enum": ["candidate_profile", "master_resume"]
                },
                "location": { "type": "string" },
                "quote": { "type": "string" },
                "allowed_claims": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "gaps": { "type": "array", "items": { "type": "string" } },
          "safe_translation": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "resume_strategy": {
      "type": "object",
      "required": ["summary", "experience", "skills"],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "object",
          "required": ["include_points", "avoid_points"],
          "additionalProperties": false,
          "properties": {
            "include_points": { "type": "array", "items": { "type": "string" } },
            "avoid_points": { "type": "array", "items": { "type": "string" } }
          }
        },
        "experience": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "role_name",
              "priority",
              "bullets_to_emphasize",
              "bullets_to_compress",
              "bullets_to_reframe"
            ],
            "additionalProperties": false,
            "properties": {
              "role_name": { "type": "string" },
              "priority": { "type": "string", "enum": ["high", "medium", "low"] },
              "bullets_to_emphasize": { "type": "array", "items": { "type": "string" } },
              "bullets_to_compress": { "type": "array", "items": { "type": "string" } },
              "bullets_to_reframe": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["before", "after_intent"],
                  "additionalProperties": false,
                  "properties": {
                    "before": { "type": "string" },
                    "after_intent": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "skills": {
          "type": "object",
          "required": ["promote_skills", "demote_skills", "do_not_add_skills"],
          "additionalProperties": false,
          "properties": {
            "promote_skills": { "type": "array", "items": { "type": "string" } },
            "demote_skills": { "type": "array", "items": { "type": "string" } },
            "do_not_add_skills": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },

    "cover_letter_strategy": {
      "type": "object",
      "required": ["company_and_role_mentions", "structure"],
      "additionalProperties": false,
      "properties": {
        "company_and_role_mentions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "structure": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "risk_checks": {
      "type": "object",
      "required": [
        "do_not_invent",
        "likely_hallucination_traps",
        "claims_requiring_strict_grounding"
      ],
      "additionalProperties": false,
      "properties": {
        "do_not_invent": { "type": "array", "items": { "type": "string" } },
        "likely_hallucination_traps": { "type": "array", "items": { "type": "string" } },
        "claims_requiring_strict_grounding": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }

  }
}
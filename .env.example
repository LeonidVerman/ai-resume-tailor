# ============================================================
# ai-resume-tailor — Environment Variables Example
# Copy to .env and fill in your values.
# NEVER commit .env — it contains secrets.
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=dev
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
ALLOWED_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL) ─────────────────────────────────────
# docker-compose sets this automatically from POSTGRES_* vars.
# Set explicitly for staging/production.
DATABASE_URL=postgresql+psycopg://tailor:tailor@localhost:5432/tailor_dev

# docker-compose postgres service credentials
POSTGRES_USER=tailor
POSTGRES_PASSWORD=tailor
POSTGRES_DB=tailor_dev

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Supabase (Auth) ───────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Object Storage (S3-compatible / Cloudflare R2) ────────────
STORAGE_ENDPOINT=https://...
STORAGE_ACCESS_KEY_ID=...
STORAGE_SECRET_ACCESS_KEY=...
STORAGE_BUCKET=ai-resume-tailor

# ── MinIO (local dev S3 replacement — docker-compose --profile storage) ──
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_PRO=price_...

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── CLI Generator (python -m tailor) ─────────────────────────
# These variables are used by the legacy CLI generator only.
ENABLE_TWO_PHASE=true
ENABLE_PLAN_REPAIR=true

PHASE1_MODEL=gpt-4o
PHASE1_TEMPERATURE=0.3
PHASE1_MAX_TOKENS=4096

PHASE2_MODEL=gpt-4o
PHASE2_TEMPERATURE=0.5
PHASE2_MAX_TOKENS=8192

PHASE2_JUDGE_MODEL=gpt-4o-mini
ENABLE_PHASE2_JUDGE=true

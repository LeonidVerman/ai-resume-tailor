# backend/.env.example
# Backend-specific environment variables.
# Copy to backend/.env and fill in your values.

# App
APP_ENV=development
SECRET_KEY=changeme-generate-a-real-secret

# Logging — set to enable daily rotating log files (required for /admin/logs/download)
# LOG_DIR=/tmp/logs

# Run data — set to save per-run debug JSON files (same format as CLI tmp/ output)
# RUN_DATA_DIR=run_data

# Database
DATABASE_URL=postgresql+asyncpg://tailor:tailor@localhost:5432/tailor_dev

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...

# Object Storage (Cloudflare R2 or S3-compatible)
STORAGE_ENDPOINT=https://...
STORAGE_ACCESS_KEY_ID=...
STORAGE_SECRET_ACCESS_KEY=...
STORAGE_BUCKET=ai-resume-tailor

# OpenAI
OPENAI_API_KEY=sk-...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_PRO=price_...

# CORS
ALLOWED_ORIGINS=http://localhost:3000

{
  "type": "object",
  "required": [
    "role_level",
    "resume_mode",
    "jd_domain",
    "candidate_primary_domain",
    "domain_mismatch",
    "domain_translation_rule_ids",
    "jd_top_themes",
    "vocabulary_anchoring",
    "evidence_map",
    "resume_strategy",
    "cover_letter_strategy",
    "risk_checks",
    "narrative_plan",
    "skill_graph"
  ],
  "additionalProperties": false,
  "properties": {
    "role_level": {
      "type": "string",
      "enum": ["director", "manager", "principal", "staff", "senior", "mid", "junior"]
    },

    "resume_mode": {
      "type": "string",
      "enum": [
        "technical_depth",
        "manager_delivery",
        "architecture_governance",
        "product_growth",
        "culture_building"
      ]
    },

    "jd_domain": {
      "type": "string",
      "enum": [
        "fintech_trading", "fintech_payments", "crypto_web3",
        "b2b_saas_platform", "consumer_saas", "marketplace",
        "healthcare_enterprise", "gov_public_sector", "edtech",
        "security_privacy", "devtools_platform", "data_analytics",
        "growth_plg", "mobile_apps", "identity_access", "infra_cloud_ops"
      ]
    },

    "candidate_primary_domain": {
      "type": "string",
      "enum": [
        "fintech_trading", "fintech_payments", "crypto_web3",
        "b2b_saas_platform", "consumer_saas", "marketplace",
        "healthcare_enterprise", "gov_public_sector", "edtech",
        "security_privacy", "devtools_platform", "data_analytics",
        "growth_plg", "mobile_apps", "identity_access", "infra_cloud_ops"
      ]
    },

    "domain_mismatch": { "type": "boolean" },

    "domain_translation_rule_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 0,
      "maxItems": 3
    },

    "jd_top_themes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["theme", "priority", "why_important", "keywords"],
        "additionalProperties": false,
        "properties": {
          "theme": { "type": "string" },
          "priority": { "type": "string", "enum": ["primary", "secondary", "supporting"] },
          "why_important": { "type": "string" },
          "keywords": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "vocabulary_anchoring": {
      "type": "object",
      "required": ["must_embed", "optional_embed"],
      "additionalProperties": false,
      "properties": {
        "must_embed": { "type": "array", "items": { "type": "string" }, "minItems": 0, "maxItems": 6 },
        "optional_embed": { "type": "array", "items": { "type": "string" }, "minItems": 0, "maxItems": 8 }
      }
    },

    "evidence_map": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["theme", "evidence", "gaps", "safe_translation"],
        "additionalProperties": false,
        "properties": {
          "theme": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source", "location", "quote", "allowed_claims"],
              "additionalProperties": false,
              "properties": {
                "source": { "type": "string", "enum": ["candidate_profile", "master_resume"] },
                "location": { "type": "string" },
                "quote": { "type": "string" },
                "allowed_claims": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "gaps": { "type": "array", "items": { "type": "string" } },
          "safe_translation": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "resume_strategy": {
      "type": "object",
      "required": ["summary", "experience", "skills"],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "object",
          "required": ["include_points", "avoid_points"],
          "additionalProperties": false,
          "properties": {
            "include_points": { "type": "array", "items": { "type": "string" } },
            "avoid_points": { "type": "array", "items": { "type": "string" } }
          }
        },
        "experience": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "role_name",
              "priority",
              "bullets_to_emphasize",
              "bullets_to_compress",
              "bullets_to_reframe"
            ],
            "additionalProperties": false,
            "properties": {
              "role_name": { "type": "string" },
              "priority": { "type": "string", "enum": ["high", "medium", "low"] },
              "bullets_to_emphasize": { "type": "array", "items": { "type": "string" } },
              "bullets_to_compress": { "type": "array", "items": { "type": "string" } },
              "bullets_to_reframe": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["before", "after_intent"],
                  "additionalProperties": false,
                  "properties": {
                    "before": { "type": "string" },
                    "after_intent": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "skills": {
          "type": "object",
          "required": ["promote_skills", "demote_skills", "do_not_add_skills"],
          "additionalProperties": false,
          "properties": {
            "promote_skills": { "type": "array", "items": { "type": "string" } },
            "demote_skills": { "type": "array", "items": { "type": "string" } },
            "do_not_add_skills": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },

    "cover_letter_strategy": {
      "type": "object",
      "required": ["company_and_role_mentions", "structure"],
      "additionalProperties": false,
      "properties": {
        "company_and_role_mentions": { "type": "array", "items": { "type": "string" } },
        "structure": { "type": "array", "items": { "type": "string" } }
      }
    },

    "risk_checks": {
      "type": "object",
      "required": [
        "do_not_invent",
        "likely_hallucination_traps",
        "claims_requiring_strict_grounding"
      ],
      "additionalProperties": false,
      "properties": {
        "do_not_invent": { "type": "array", "items": { "type": "string" } },
        "likely_hallucination_traps": { "type": "array", "items": { "type": "string" } },
        "claims_requiring_strict_grounding": { "type": "array", "items": { "type": "string" } }
      }
    },

    "narrative_plan": {
      "type": "object",
      "required": [
        "anchor_role_id",
        "theme_ranked",
        "summary_coverage",
        "anchor_role_coverage",
        "domain_translation_binding"
      ],
      "additionalProperties": false,
      "properties": {
        "anchor_role_id": { "type": "string", "minLength": 1 },

        "theme_ranked": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["theme_id", "label", "priority", "signature_terms"],
            "additionalProperties": false,
            "properties": {
              "theme_id": { "type": "string" },
              "label": { "type": "string" },
              "priority": { "type": "string", "enum": ["primary", "secondary", "supporting"] },
              "signature_terms": {
                "type": "array",
                "minItems": 3,
                "maxItems": 12,
                "items": { "type": "string" }
              }
            }
          }
        },

        "summary_coverage": {
          "type": "object",
          "required": ["must_cover_theme_ids", "should_cover_theme_ids"],
          "additionalProperties": false,
          "properties": {
            "must_cover_theme_ids": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "type": "string" } },
            "should_cover_theme_ids": { "type": "array", "minItems": 0, "maxItems": 2, "items": { "type": "string" } }
          }
        },

        "anchor_role_coverage": {
          "type": "object",
          "required": ["first_k_bullets", "top_k_themes_to_cover", "min_theme_occurrences"],
          "additionalProperties": false,
          "properties": {
            "first_k_bullets": { "type": "integer", "minimum": 2, "maximum": 5 },
            "top_k_themes_to_cover": { "type": "integer", "minimum": 1, "maximum": 3 },
            "min_theme_occurrences": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["theme_id", "min_count"],
                "additionalProperties": false,
                "properties": {
                  "theme_id": { "type": "string" },
                  "min_count": { "type": "integer", "minimum": 0, "maximum": 4 }
                }
              }
            }
          }
        },

        "domain_translation_binding": {
          "type": "object",
          "required": [
            "min_total_rule_instantiations",
            "min_instantiations_in_anchor_role",
            "require_target_frame_in_anchor_role_first_k"
          ],
          "additionalProperties": false,
          "properties": {
            "min_total_rule_instantiations": { "type": "integer", "minimum": 0, "maximum": 5 },
            "min_instantiations_in_anchor_role": { "type": "integer", "minimum": 0, "maximum": 3 },
            "require_target_frame_in_anchor_role_first_k": { "type": "boolean" }
          }
        }
      }
    },

    "skill_graph": {
      "type": "object",
      "required": [
        "direct_skills",
        "related_skills"
      ],
      "additionalProperties": false,
      "properties": {
        "direct_skills": {
          "type": "array",
          "minItems": 5,
          "items": { "type": "string" },
          "description": "Skills/tools explicitly supported by master_resume or candidate_profile."
        },
        "related_skills": {
          "type": "array",
          "minItems": 0,
          "maxItems": 150,
          "items": {
            "type": "object",
            "required": [
              "root_skill",
              "item",
              "derivation_type",
              "confidence",
              "allowed_usage"
            ],
            "additionalProperties": false,
            "properties": {
              "root_skill": { "type": "string", "minLength": 1 },
              "item": { "type": "string", "minLength": 1 },

              "derivation_type": {
                "type": "string",
                "enum": ["concept", "method", "pattern", "tool", "responsibility"]
              },

              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },

              "allowed_usage": {
                "type": "string",
                "enum": ["skills_section_only", "can_claim_experience", "forbidden"]
              }
            }
          }
        }
      }
    }
  }
}